kaggle_underwater_dataset/eval/results/
kaggle_underwater_dataset/eval/user_input.png
CFD_fishial/results/
CFD_fishial/test_videos/
zeroshot_test/output_frames/
zeroshot_test/temp_frames/
*.zip

# =============================================
#  영상/이미지 출력물
# =============================================
*.mp4
*.mov
*.avi
zeroshot_test/temp_gradio_upload.jpg

# =============================================
#  Jupyter Notebook (대용량 출력 포함)
# =============================================
.ipynb_checkpoints/
kaggle_underwater_dataset/underwater-object-detection.ipynb

# =============================================
#  로그 파일
# =============================================
*.log
sg_logs/

# =============================================
#  보안 / 환경변수
# =============================================
.env
.env.*
*.key
*.pem
*.p12
*.secret
credentials/
secrets/

# =============================================
#  IDE / 에디터
# =============================================
.vscode/
.idea/
*.swp
*.swo
*~
.project
.settings/

# =============================================
#  OS 생성 파일
# =============================================
Thumbs.db
Desktop.ini
.DS_Store
__MACOSX/
*.tmp

# =============================================

# ============================================
# Divery AI Worker - Environment Variables
# ============================================
# Copy this file to .env and fill in actual values.
# NEVER commit .env files with real credentials!
# ============================================

# ===========================================
# AWS CREDENTIALS
# ===========================================

# AWS access credentials for S3 and SQS
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=ap-northeast-2

# ===========================================
# S3 STORAGE
# ===========================================

# S3 bucket for media files
S3_BUCKET_NAME=divery-media-j14a402

# ===========================================
# SQS QUEUE
# ===========================================

# SQS queue URL for job processing
# Create queue in AWS console first
SQS_QUEUE_URL=https://sqs.ap-northeast-2.amazonaws.com/<account-id>/<queue-name>

# Optional: CloudFront URL for S3 content delivery
CLOUDFRONT_DOMAIN=https://d2mhdpnsprcj0k.cloudfront.net
CLOUDFRONT_DOMAINS=

# ===========================================
# BACKEND CALLBACK
# ===========================================

# Backend base URL for sending results
# NOTE: base URL only (do not append /api). staging can use /stg
BACKEND_CALLBACK_BASE_URL=https://j14a402.p.ssafy.io

# Signing secret for callback authentication
AI_CALLBACK_SIGNING_SECRET=change-me

# ===========================================
# LOGBOOK LLM CONFIGURATION
# ===========================================

# GMS API key for LLM access
GMS_KEY=

# LLM mode: auto, enabled, disabled
LOGBOOK_LLM_ENABLED=auto

# LLM API endpoint
LOGBOOK_LLM_URL=https://gms.ssafy.io/gmsapi/api.openai.com/v1/chat/completions

# Model to use
LOGBOOK_LLM_MODEL=gpt-5-mini

# Request settings
LOGBOOK_LLM_TIMEOUT_SECONDS=20
LOGBOOK_LLM_RETRY_COUNT=2
LOGBOOK_LLM_TEMPERATURE=0.4
LOGBOOK_LLM_MAX_TOKENS=300
LOGBOOK_LLM_MAX_CHARS=320

# ===========================================
# WORKER MODE
# ===========================================

# Dummy mode: false = real processing, true = skip AI (for testing)
WORKER_DUMMY_MODE=false

# ===========================================
# CFD PIPELINE CONFIGURATION
# ===========================================

# Path to CFD pipeline directory (relative to worker)
CFD_PIPELINE_DIR=../CFD_fishial

# Integration script path
CFD_INTEGRATION_SCRIPT=../CFD_fishial/integration.py

# Python binary for CFD
CFD_PYTHON_BIN=python

# Model settings
CFD_MODEL=bioclip2
CFD_MODE=open-domain
CFD_CONF_THRESHOLD=0.5
CFD_DISABLE_FP16=false

# Zero-shot classification classes (comma-separated, optional)
CFD_ZERO_SHOT_CLASSES=

# ===========================================
# HIGHLIGHT EXTRACTION
# ===========================================

# Number of highlight frames to extract
HIGHLIGHT_TOP_K=5

# Minimum gap between highlights (seconds)
HIGHLIGHT_MIN_GAP_SECONDS=2

# YOLO model weights path
HIGHLIGHT_MODEL_WEIGHTS=../CFD_fishial/weights/yolov8l-world.pt

# Detection confidence threshold
HIGHLIGHT_MODEL_CONF=0.1

# ===========================================
# RUNTIME LIMITS
# ===========================================

# Maximum pipeline execution time (seconds)
PIPELINE_TIMEOUT_SECONDS=7200

# Download timeout for media files (seconds)
DOWNLOAD_TIMEOUT_SECONDS=120

# SQS polling settings
SQS_WAIT_TIME_SECONDS=20
SQS_VISIBILITY_TIMEOUT=900
SQS_VISIBILITY_HEARTBEAT_SECONDS=300

# Callback settings
CALLBACK_TIMEOUT_SECONDS=10
CALLBACK_RETRY_COUNT=3
CALLBACK_RETRY_DELAY_SECONDS=2

# ===========================================
# OPERATIONAL OPTIONS
# ===========================================

# Keep work directory after processing (for debugging)
WORKER_KEEP_WORKDIR=false

# Temporary directory for worker files
WORKER_TMP_DIR=/tmp/divery-ai-worker

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
